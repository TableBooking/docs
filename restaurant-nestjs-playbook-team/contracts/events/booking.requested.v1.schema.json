{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "booking.requested.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "aggregateId",
    "occurredAt",
    "producer",
    "correlationId",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "booking.requested.v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "required": [
        "customerId",
        "email",
        "slotId",
        "partySize"
      ],
      "properties": {
        "customerId": {
          "type": "string",
          "format": "uuid"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "slotId": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}-(lunch|dinner)$"
        },
        "partySize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "note": {
          "type": "string"
        },
        "contactPhone": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}