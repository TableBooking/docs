{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "booking.state-changed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "aggregateId",
    "occurredAt",
    "producer",
    "correlationId",
    "data",
    "aggregateVersion"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "booking.state-changed.v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "required": [
        "previousState",
        "state",
        "customerId",
        "email",
        "slotId",
        "partySize",
        "actorId"
      ],
      "properties": {
        "previousState": {
          "enum": [
            "REQUESTED",
            "CONFIRMED",
            "REJECTED",
            "CANCELLED",
            "CHECKED_IN",
            "SEATED",
            "COMPLETED",
            "NO_SHOW",
            null
          ]
        },
        "state": {
          "enum": [
            "REQUESTED",
            "CONFIRMED",
            "REJECTED",
            "CANCELLED",
            "CHECKED_IN",
            "SEATED",
            "COMPLETED",
            "NO_SHOW"
          ]
        },
        "customerId": {
          "type": "string",
          "format": "uuid"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "tableId": {
          "type": [
            "string",
            "null"
          ]
        },
        "slotId": {
          "type": "string"
        },
        "partySize": {
          "type": "integer",
          "minimum": 1
        },
        "actorId": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "commandId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false
    }
  }
}